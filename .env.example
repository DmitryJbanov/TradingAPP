# auto: Binance + optional Twelve Data, explicit DEMO fallback on failure.
# demo: deterministic synthetic fixtures, no external requests.
DATA_MODE=auto
TWELVE_DATA_API_KEY=
PORT=3000
HOST=0.0.0.0

# Standalone multi-user accounts and profiles (Docker Compose)
# Set this to the public HTTPS origin when publishing behind a TLS proxy.
PUBLIC_ORIGIN=https://terminal.example.com
SESSION_COOKIE_SECURE=true
DATABASE_PATH=/data/divmoney.sqlite

# Optional external headless parser. No parsing starts automatically.
COINGLASS_SERVICE_URL=http://127.0.0.1:8090
COINGLASS_TOKEN=
