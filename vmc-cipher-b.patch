+  if (p.sommiDiamondShow)
+    a.push(vmcTimeframes[p.sommiHTCRes], vmcTimeframes[p.sommiHTCRes2]);
+  if (p.macdWTColorsShow) a.push(vmcTimeframes[p.macdWTColorsTF]);
+  return [...new Set(a)];
+}
+export function computeVmc(
+  bars: Candle[],
+  raw: unknown = {},
+  ctx: VmcContext = {},
