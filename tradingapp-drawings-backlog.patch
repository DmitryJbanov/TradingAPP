+        </div>
+        <section className="panel">
+          <ol className="backlog-list">
+            {backlog.map((task) => (
+              <li key={task.id}>
+                <h2>{task.title}</h2>
+                <p>{task.description}</p>
+              </li>
+            ))}
+          </ol>
+          {!backlog.length && (
+            <p className="empty-state">Все запланированные задачи выполнены.</p>
+          )}
+        </section>
+        <a className="button" href="/">
+          Вернуться к рынкам
+        </a>
+      </main>
+    </div>
+  );
+}
